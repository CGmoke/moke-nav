<?xml version="1.0"?>
<!--
  base.xacro — 车体：base_link（底盘框架）+ platform_link（顶板）+ arm_base_link（机械臂基座）
  base_link 原点在地面上；电池/4 电机/轮轴/计算单元不单独建模，质量并入 base_link（11.9 kg）。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 外观网格（外观 v2.5）：visual 引用 meshes/ 下的 .dae（自带材质色）；
       碰撞体保持简化几何体（规范要求，禁止复用外观 mesh）。 -->

  <!-- ==================== base_link 底盘框架 520×400×120 mm ==================== -->
  <link name="base_link">
    <!-- 外观 mesh：底盘箱体 + 前脸青色灯带（已在 mesh 内合并，坐标以 link 原点为基准） -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nav_bot_description/meshes/base_link.dae"/>
      </geometry>
      <material name="chassis_dark"/>
    </visual>
    <collision>
      <!-- 简化几何体：与 visual 相同的 box（禁止复用高精度 mesh） -->
      <origin xyz="0 0 ${chassis_center_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_x} ${chassis_y} ${chassis_z}"/>
      </geometry>
    </collision>
    <!-- 惯量并入电池后按整箱近似，质心偏后（电池底面居中偏后，配重项） -->
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="-0.03 0 ${chassis_center_z}" rpy="0 0 0"/>
      <inertia
        ixx="${base_mass * (chassis_y*chassis_y + chassis_z*chassis_z) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${base_mass * (chassis_x*chassis_x + chassis_z*chassis_z) / 12.0}"
        iyz="0.0"
        izz="${base_mass * (chassis_x*chassis_x + chassis_y*chassis_y) / 12.0}"/>
    </inertial>
  </link>

  <!-- ==================== platform_link 平台顶板 400×320×8 mm ==================== -->
  <joint name="platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="platform_link"/>
    <origin xyz="0 0 ${platform_joint_z}" rpy="0 0 0"/>
  </joint>
  <link name="platform_link">
    <!-- 外观 mesh：顶板 + 四根支撑角柱（已在 mesh 内合并） -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nav_bot_description/meshes/platform_link.dae"/>
      </geometry>
      <material name="body_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${platform_x} ${platform_y} ${platform_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="${platform_mass}" x="${platform_x}" y="${platform_y}" z="${platform_z}"/>
  </link>

  <!-- ==================== arm_base_link 机械臂安装基座（预留） ==================== -->
  <!-- 4×M6 孔位 250×200 mm，锁附底盘立柱；Z 轴预留 0.45 m（含回转） -->
  <joint name="arm_mount_joint" type="fixed">
    <parent link="platform_link"/>
    <child link="arm_base_link"/>
    <origin xyz="${arm_mount_x} 0 ${arm_mount_z}" rpy="0 0 0"/>
  </joint>
  <link name="arm_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://nav_bot_description/meshes/arm_base_link.dae"/>
      </geometry>
      <material name="accent_amber"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${arm_base_z / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${arm_base_x} ${arm_base_y} ${arm_base_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${arm_base_mass}"/>
      <origin xyz="0 0 ${arm_base_z / 2.0}" rpy="0 0 0"/>
      <inertia
        ixx="${arm_base_mass * (arm_base_y*arm_base_y + arm_base_z*arm_base_z) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${arm_base_mass * (arm_base_x*arm_base_x + arm_base_z*arm_base_z) / 12.0}"
        iyz="0.0"
        izz="${arm_base_mass * (arm_base_x*arm_base_x + arm_base_y*arm_base_y) / 12.0}"/>
    </inertial>
  </link>

</robot>
