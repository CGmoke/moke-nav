<?xml version="1.0"?>
<!--
  inertia.xacro — 简化惯性张量宏（盒 / 圆柱 / 球近似）
  规范要求：inertial 为简化惯量，Gazebo 仿真够用，精确值后续用 CAD 导出替换。
  注意：每个 link 必须有非零质量的 inertial，质量为 0 会让模型在 Gazebo 里乱飞。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- 长方体（均匀密度），轴线沿自身 x/y/z -->
  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 实心圆柱，旋转轴为自身 z（URDF cylinder 几何轴） -->
  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (3.0 * radius*radius + length*length) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${mass * (3.0 * radius*radius + length*length) / 12.0}"
        iyz="0.0"
        izz="${0.5 * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

  <!-- 驱动轮专用：几何经 rpy=90° 绕 x 旋转，旋转轴对齐 link 的 y 轴 -->
  <xacro:macro name="wheel_inertial" params="mass radius width">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${mass * (3.0 * radius*radius + width*width) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${0.5 * mass * radius*radius}"
        iyz="0.0"
        izz="${mass * (3.0 * radius*radius + width*width) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 实心球（万向轮碰撞/惯量近似） -->
  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <mass value="${mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${0.4 * mass * radius*radius}"
        ixy="0.0" ixz="0.0"
        iyy="${0.4 * mass * radius*radius}"
        iyz="0.0"
        izz="${0.4 * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

</robot>
