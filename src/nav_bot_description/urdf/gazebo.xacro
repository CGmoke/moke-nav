<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== 差速驱动系统（4WD：同侧两轮速度一致） ==================== -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_wheel_joint</left_joint>
      <left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint>
      <right_joint>right_rear_wheel_joint</right_joint>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <!-- ★ TF 改发到 /tf_gz_odom 且不做桥接。
           轮式里程计的 TF 在 4WD 滑移转向下误差极大（实测旋转虚报 2.6×），
           odom->base_footprint 改由 robot_localization EKF 发布（见 config/ekf.yaml）。
           同一时刻只能有一个发布者，否则 TF 打架、odom 抽搐。 -->
      <tf_topic>/tf_gz_odom</tf_topic>
      <frame_id>odom</frame_id>
      <!-- ★ 必须写 base_footprint：URDF 根 link 是零质量的 base_footprint，
           base_link 通过固定关节挂在它下面，gz 合并后模型基准 link 就是 base_footprint。
           写 base_link 会和 robot_state_publisher 发的 base_footprint->base_link
           形成"一个子帧两个父帧"，TF 打架。 -->
      <child_frame_id>base_footprint</child_frame_id>
      <min_linear_velocity>-${max_linear_vel}</min_linear_velocity>
      <max_linear_velocity>${max_linear_vel}</max_linear_velocity>
      <min_angular_velocity>-${max_angular_vel}</min_angular_velocity>
      <max_angular_velocity>${max_angular_vel}</max_angular_velocity>
    </plugin>
  </gazebo>

  <!-- ==================== 关节状态发布（驱动轮 continuous 关节需要） ==================== -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>left_front_wheel_joint</joint_name>
      <joint_name>right_front_wheel_joint</joint_name>
      <joint_name>left_rear_wheel_joint</joint_name>
      <joint_name>right_rear_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ==================== 驱动轮摩擦（4WD 滑移转向关键参数） ==================== -->
  <!-- mu1=滚动方向摩擦（高，提供驱动力）；mu2=侧向摩擦（低，转弯必须侧滑！）。
       实测：mu1=0.3/mu2=0.9（装反）→ 完全无法转向、纯侧滑；
       mu1=1.0/mu2=0.3 → 转向正常（空地 1 rad/s 指令 14s 转 ~90°）。 -->
  <gazebo reference="wheel_lf_link">
    <mu1>1.0</mu1><mu2>0.3</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_rf_link">
    <mu1>1.0</mu1><mu2>0.3</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_lb_link">
    <mu1>1.0</mu1><mu2>0.3</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>
  <gazebo reference="wheel_rb_link">
    <mu1>1.0</mu1><mu2>0.3</mu2>
    <kp>1000000.0</kp><kd>100.0</kd>
  </gazebo>

  <!-- ==================== 激光雷达（gpu_lidar） ==================== -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <!-- ★ gz_frame_id 必须写 URDF 的 link 名。不写的话 gz 会拼成
           "<模型名>/<模型根link>/<传感器名>" = nav_bot/base_link/lidar，
           ROS 侧 TF 树里没有这个 frame → slam_toolbox / costmap 全部
           报 "Message Filter dropping message: queue is full"。 -->
      <gz_frame_id>lidar_link</gz_frame_id>
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ==================== IMU ==================== -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>imu/data</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.017</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- ==================== 深度相机（隐藏式，外形 v2.4） ==================== -->
  <!-- 相机机身藏于车头内，前脸仅一块齐平玻璃窗。-15° 下俯角在传感器 pose 中实现；
       pose x +5mm 把传感器原点推到面板外，避免虚拟相机被底盘前壁自身遮挡。 -->
  <gazebo reference="depth_camera_link">
    <sensor name="depth_camera" type="rgbd_camera">
      <pose>0.005 0 0 0 ${depth_cam_pitch} 0</pose>
      <gz_frame_id>depth_camera_link</gz_frame_id>
      <topic>depth_camera</topic>
      <update_rate>15</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.0297</horizontal_fov>  <!-- ~59° -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.28</near>
          <far>10.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ==================== RGB 摄像头 ==================== -->
  <gazebo reference="camera_link">
    <sensor name="rgb_camera" type="camera">
      <gz_frame_id>camera_link</gz_frame_id>
      <topic>camera/image</topic>
      <update_rate>30</update_rate>
      <always_on>true</always_on>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>  <!-- 60° -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
