<?xml version="1.0"?>
<!--
  sensors.xacro — 传感器套件：lidar_link / imu_link / depth_camera_link / camera_link
  布局约束（规范稿）：
    - 雷达水平无遮挡，带底座法兰直接坐于顶板，扫描面离地 0.28 m；
    - IMU 贴近轮轴、刚性固定，周边 100 mm 内禁止动力线；
    - 深度相机俯仰 -15°，前视；
    - 摄像头平嵌顶板前缘（外形 v2.2 取消支架杆），顶 0.259 低于扫描面 0.28，不遮挡。
  注：深度相机光学坐标系（REP-105：z 前 / x 右 / y 下）由驱动节点发布，
      此处不额外建 optical link，以保持规范稿 13 links 拓扑。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== 激光雷达 Ø90×65 mm（圆盘底座 + 圆柱，直接坐于顶板） ==================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="${lidar_xyz[0]} ${lidar_xyz[1]} ${lidar_xyz[2]}" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="sensor_navy"/>
    </visual>
    <!-- 底座法兰：桥接顶板面与雷达筒底，无外伸杆件 -->
    <visual>
      <origin xyz="0 0 ${lidar_flange_z}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_flange_radius}" length="0.012"/>
      </geometry>
      <material name="sensor_navy"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="${lidar_mass}" radius="${lidar_radius}" length="${lidar_height}"/>
  </link>

  <!-- ==================== IMU 36×24×10 mm ==================== -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_xyz[0]} ${imu_xyz[1]} ${imu_xyz[2]}" rpy="0 0 0"/>
  </joint>
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_x} ${imu_y} ${imu_z}"/>
      </geometry>
      <material name="sensor_navy"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${imu_x} ${imu_y} ${imu_z}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="${imu_mass}" x="${imu_x}" y="${imu_y}" z="${imu_z}"/>
  </link>

  <!-- ==================== 深度相机（隐藏式：藏于车头，前脸仅一块玻璃视窗） ==================== -->
  <!-- 外形 v2.4：link 水平、无任何外凸；-15° 下俯在 Gazebo 传感器 pose 中实现。
       碰撞体/惯量整体内移 40mm，保证不穿出前面板。 -->
  <joint name="depth_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
    <origin xyz="${depth_cam_xyz[0]} ${depth_cam_xyz[1]} ${depth_cam_xyz[2]}" rpy="0 0 0"/>
  </joint>
  <link name="depth_camera_link">
    <!-- 玻璃视窗：与前面板齐平的深色镜面小窗（唯一可见部分） -->
    <visual>
      <origin xyz="0.0015 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.003 ${depth_cam_win_y} ${depth_cam_win_z}"/>
      </geometry>
      <material name="lens_dark"/>
    </visual>
    <!-- 相机机身：完全藏于车头内（不可见，仅碰撞/惯量） -->
    <collision>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${depth_cam_x} ${depth_cam_y} ${depth_cam_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${depth_cam_mass}"/>
      <origin xyz="-0.04 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${depth_cam_mass * (depth_cam_y*depth_cam_y + depth_cam_z*depth_cam_z) / 12.0}"
        ixy="0.0" ixz="0.0"
        iyy="${depth_cam_mass * (depth_cam_x*depth_cam_x + depth_cam_z*depth_cam_z) / 12.0}"
        iyz="0.0"
        izz="${depth_cam_mass * (depth_cam_x*depth_cam_x + depth_cam_y*depth_cam_y) / 12.0}"/>
    </inertial>
  </link>

  <!-- ==================== RGB 摄像头 38×38×38 mm（平嵌顶板前缘，无外伸杆） ==================== -->
  <joint name="camera_joint" type="fixed">
    <parent link="platform_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_xyz[0]} ${camera_xyz[1]} ${camera_xyz[2]}"
            rpy="0 ${camera_pitch} 0"/>
  </joint>
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
      <material name="camera_gray"/>
    </visual>
    <!-- 镜头面：前侧小圆片，增加辨识度（纯视觉件） -->
    <visual>
      <origin xyz="${camera_size / 2.0 + 0.001} 0 0" rpy="0 ${pi/2.0} 0"/>
      <geometry>
        <cylinder radius="${0.55 * camera_size / 2.0}" length="0.002"/>
      </geometry>
      <material name="tire_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${camera_size} ${camera_size} ${camera_size}"/>
      </geometry>
    </collision>
    <xacro:box_inertial mass="${camera_mass}" x="${camera_size}" y="${camera_size}" z="${camera_size}"/>
  </link>

</robot>
